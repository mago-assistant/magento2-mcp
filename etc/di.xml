<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="MagoAssistant\Mcp\Api\ServerRepositoryInterface" type="MagoAssistant\Mcp\Model\Server\Repository"/>
    <preference for="MagoAssistant\Mcp\Api\McpClientInterface" type="MagoAssistant\Mcp\Service\Mcp\StdioClient"/>

    <type name="MagoAssistant\Mcp\Service\Discovery\ServerScanner">
        <arguments>
            <argument name="composerSource" xsi:type="object">MagoAssistant\Mcp\Service\Discovery\ComposerSource</argument>
            <argument name="mcpJsonSource" xsi:type="object">MagoAssistant\Mcp\Service\Discovery\McpJsonSource</argument>
        </arguments>
    </type>

    <type name="MagoAssistant\Mcp\Service\Catalog\ToolCatalog">
        <arguments>
            <argument name="cache" xsi:type="object">MagoAssistant\Mcp\Model\Cache\Type\McpTools</argument>
        </arguments>
    </type>

    <!--
        One Mago skill per MCP tool, added to Mago's registry through "after" plugins (no preference,
        no around). Nothing inside MagoAssistant_Mago is edited.
    -->
    <type name="MagoAssistant\Mago\Service\Tool\ToolRegistry">
        <plugin name="mago_mcp_skills" type="MagoAssistant\Mcp\Plugin\ToolRegistryMcpSkills"/>
    </type>

    <!-- Status line only: 'Running <name>...' becomes a phrase such as 'Getting order...'; the tag is the skill name already. -->
    <type name="MagoAssistant\Mago\Service\Ai\ChatService">
        <plugin name="mago_mcp_tool_display" type="MagoAssistant\Mcp\Plugin\ChatServiceToolDisplay"/>
    </type>

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="mago_mcp_discover" xsi:type="object">MagoAssistant\Mcp\Console\Command\DiscoverServers</item>
                <item name="mago_mcp_list" xsi:type="object">MagoAssistant\Mcp\Console\Command\ListServers</item>
                <item name="mago_mcp_refresh" xsi:type="object">MagoAssistant\Mcp\Console\Command\RefreshTools</item>
                <item name="mago_mcp_enable" xsi:type="object">MagoAssistant\Mcp\Console\Command\EnableServer</item>
                <item name="mago_mcp_disable" xsi:type="object">MagoAssistant\Mcp\Console\Command\DisableServer</item>
            </argument>
        </arguments>
    </type>
</config>
