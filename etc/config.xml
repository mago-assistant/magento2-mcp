<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <mago>
            <mcp>
                <enabled>1</enabled>
                <scan_mcp_json>1</scan_mcp_json>
                <process_timeout>60</process_timeout>
                <cache_lifetime>3600</cache_lifetime>
                <max_result_chars>16000</max_result_chars>
                <worker_address>127.0.0.1:8765</worker_address>
                <worker_listen/>
                <worker_autostart>1</worker_autostart>
            </mcp>
        </mago>
    </default>
</config>
