<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="mago_mcp_server" resource="default" engine="innodb" comment="Mago MCP servers">
        <column xsi:type="int" name="server_id" unsigned="true" nullable="false" identity="true" comment="Server ID"/>
        <column xsi:type="varchar" name="name" nullable="false" length="64" comment="Unique server name"/>
        <column xsi:type="text" name="command" nullable="false" comment="JSON array: executable and arguments"/>
        <column xsi:type="text" name="env" nullable="true" comment="JSON object of environment variables"/>
        <column xsi:type="varchar" name="cwd" nullable="true" length="255" comment="Working directory"/>
        <column xsi:type="varchar" name="label" nullable="true" length="128" comment="Label shown to admins and in tool descriptions"/>
        <column xsi:type="varchar" name="transport" nullable="false" length="8" default="stdio" comment="stdio or http"/>
        <column xsi:type="varchar" name="url" nullable="true" length="255" comment="MCP endpoint (http)"/>
        <column xsi:type="varchar" name="auth_type" nullable="false" length="8" default="none" comment="none, bearer or oauth"/>
        <column xsi:type="text" name="bearer_token" nullable="true" comment="Encrypted bearer token"/>
        <column xsi:type="text" name="allowed_tools" nullable="true" comment="JSON list of tool names; empty allows all"/>
        <column xsi:type="smallint" name="timeout" unsigned="true" nullable="true" identity="false" comment="Seconds per call; null uses the global default"/>
        <column xsi:type="smallint" name="output_public" unsigned="true" nullable="false" identity="false" default="0" comment="Result may cross to the AI provider as public data"/>
        <column xsi:type="varchar" name="replaces_skill" nullable="true" length="64" comment="Mago skill hidden for admins offered this server"/>
        <column xsi:type="varchar" name="source" nullable="false" length="16" default="manual" comment="composer, mcp_json, module or manual"/>
        <column xsi:type="smallint" name="enabled" unsigned="true" nullable="false" identity="false" default="0" comment="Exposed to the assistant"/>
        <column xsi:type="smallint" name="missing" unsigned="true" nullable="false" identity="false" default="0" comment="Last scan did not find it"/>
        <column xsi:type="text" name="last_error" nullable="true" comment="Last tools/list failure"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="server_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MAGO_MCP_SERVER_NAME">
            <column name="name"/>
        </constraint>
    </table>
    <table name="mago_mcp_oauth_client" resource="default" engine="innodb" comment="Mago MCP OAuth client registrations">
        <column xsi:type="varchar" name="server_code" nullable="false" length="64" comment="MCP server code"/>
        <column xsi:type="varchar" name="server_url" nullable="false" length="255" comment="MCP server URL the registration belongs to"/>
        <column xsi:type="varchar" name="redirect_uri" nullable="false" length="255" comment="Registered redirect URI"/>
        <column xsi:type="varchar" name="client_id" nullable="false" length="255" comment="Client ID"/>
        <column xsi:type="text" name="client_secret" nullable="true" comment="Encrypted client secret"/>
        <column xsi:type="text" name="metadata" nullable="false" comment="Discovered endpoints, resource and scopes (JSON)"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="server_code"/>
        </constraint>
    </table>
    <table name="mago_mcp_token" resource="default" engine="innodb" comment="Mago MCP OAuth tokens per admin user">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="admin_user_id" unsigned="true" nullable="false" comment="Admin User ID"/>
        <column xsi:type="varchar" name="server_code" nullable="false" length="64" comment="MCP server code"/>
        <column xsi:type="text" name="access_token" nullable="false" comment="Encrypted access token"/>
        <column xsi:type="text" name="refresh_token" nullable="true" comment="Encrypted refresh token"/>
        <column xsi:type="datetime" name="expires_at" nullable="true" comment="Access token expiry (UTC)"/>
        <column xsi:type="varchar" name="scope" nullable="true" length="255" comment="Granted scope"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MAGO_MCP_TOKEN_USER_SERVER">
            <column name="admin_user_id"/>
            <column name="server_code"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MAGO_MCP_TOKEN_ADMIN_USER_ID_ADMIN_USER_USER_ID" table="mago_mcp_token" column="admin_user_id" referenceTable="admin_user" referenceColumn="user_id" onDelete="CASCADE"/>
    </table>
</schema>
