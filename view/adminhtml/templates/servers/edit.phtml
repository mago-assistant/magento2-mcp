<?php
/**
 * Copyright © Mago Assistant
 */

/** @var \MagoAssistant\Mcp\Block\Adminhtml\ServerEdit $block */
/** @var \Magento\Framework\Escaper $escaper */
$server = $block->getServer();
$tools = $block->getTools();
?>

<form method="post" action="<?= $escaper->escapeUrl($block->getSaveUrl()) ?>">
    <?= /* @noEscape */ $block->getBlockHtml('formkey') ?>

    <div class="admin__page-section">
        <div class="admin__page-section-title">
            <span class="title"><?= $escaper->escapeHtml(__('Server')) ?></span>
        </div>
        <div class="admin__page-section-content">
            <div class="admin__field">
                <label class="admin__field-label"><?= $escaper->escapeHtml(__('Name')) ?></label>
                <div class="admin__field-control">
                    <?php if ($server): ?>
                        <input type="hidden" name="name" value="<?= $escaper->escapeHtmlAttr($server['name']) ?>"/>
                        <strong><?= $escaper->escapeHtml($server['name']) ?></strong> (<?= $escaper->escapeHtml($server['source']) ?>)
                    <?php else: ?>
                        <input type="text" name="name" class="admin__control-text" required pattern="[a-z0-9_-]+"/>
                    <?php endif; ?>
                </div>
            </div>
            <div class="admin__field">
                <label class="admin__field-label"><?= $escaper->escapeHtml(__('Command')) ?></label>
                <div class="admin__field-control">
                    <?php if ($block->isManual()): ?>
                        <input type="text" name="command" class="admin__control-text"
                               value="<?= $escaper->escapeHtmlAttr(implode(' ', $server['command'] ?? [])) ?>"/>
                        <p class="note"><?= $escaper->escapeHtml(__('Split on spaces, no quoting. Relative paths resolve from the Magento root inside the PHP process.')) ?></p>
                    <?php else: ?>
                        <code><?= $escaper->escapeHtml(implode(' ', $server['command'])) ?></code>
                    <?php endif; ?>
                </div>
            </div>
            <?php if ($block->isManual()): ?>
                <div class="admin__field">
                    <label class="admin__field-label"><?= $escaper->escapeHtml(__('Working directory')) ?></label>
                    <div class="admin__field-control">
                        <input type="text" name="cwd" class="admin__control-text" value="<?= $escaper->escapeHtmlAttr((string)($server['cwd'] ?? '')) ?>"/>
                    </div>
                </div>
                <div class="admin__field">
                    <label class="admin__field-label"><?= $escaper->escapeHtml(__('Environment (KEY=value per line)')) ?></label>
                    <div class="admin__field-control">
                        <textarea name="env" class="admin__control-textarea" rows="3"><?= $escaper->escapeHtml($block->envAsText($server['env'] ?? [])) ?></textarea>
                    </div>
                </div>
            <?php endif; ?>
            <div class="admin__field">
                <label class="admin__field-label"><?= $escaper->escapeHtml(__('Enabled')) ?></label>
                <div class="admin__field-control">
                    <input type="checkbox" name="enabled" value="1" <?= ($server['enabled'] ?? false) ? 'checked' : '' ?>/>
                </div>
            </div>
        </div>
    </div>

    <?php if ($server): ?>
        <div class="admin__page-section">
            <div class="admin__page-section-title">
                <span class="title"><?= $escaper->escapeHtml(__('Tools')) ?></span>
            </div>
            <div class="admin__page-section-content">
                <?php if ($tools === []): ?>
                    <p class="note"><?= $escaper->escapeHtml(__('No tools could be fetched from this server. Check the status column on the servers page.')) ?></p>
                <?php endif; ?>
                <?php if ($block->hasPersonalDataTools()): ?>
                    <div class="message message-warning">
                        <?= $escaper->escapeHtml(__('Tools marked "personal data" return customer or order records. They are exposed by default in this build; Mago scrubs emails, phone numbers and similar values heuristically but not names or addresses. Set a tool to "disabled" if that is not acceptable for your store.')) ?>
                    </div>
                <?php endif; ?>
                <table class="data-grid">
                    <thead>
                        <tr>
                            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Tool')) ?></th>
                            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Description')) ?></th>
                            <th class="data-grid-th"><?= $escaper->escapeHtml(__('Mode')) ?></th>
                        </tr>
                    </thead>
                    <tbody>
                    <?php foreach ($tools as $tool): ?>
                        <tr>
                            <td>
                                <code><?= $escaper->escapeHtml($tool->tool) ?></code>
                                <?php if ($tool->title !== ''): ?><br/><?= $escaper->escapeHtml($tool->title) ?><?php endif; ?>
                                <?php if ($tool->irreversible): ?><br/><small><?= $escaper->escapeHtml(__('irreversible')) ?></small><?php endif; ?>
                                <?php if ($tool->personalData): ?><br/><small class="grid-severity-major"><?= $escaper->escapeHtml(__('personal data')) ?></small><?php endif; ?>
                            </td>
                            <td><?= $escaper->escapeHtml($tool->description) ?></td>
                            <td>
                                <select name="modes[<?= $escaper->escapeHtmlAttr($tool->tool) ?>]" class="admin__control-select">
                                    <option value=""><?= $escaper->escapeHtml(__('Automatic (%1)', $block->automaticMode($tool))) ?></option>
                                    <?php foreach (['read', 'write', 'disabled'] as $mode): ?>
                                        <option value="<?= $escaper->escapeHtmlAttr($mode) ?>"
                                            <?= ($tool->modeOrigin === 'override' && $tool->mode === $mode) ? 'selected' : '' ?>>
                                            <?= $escaper->escapeHtml($mode) ?>
                                        </option>
                                    <?php endforeach; ?>
                                </select>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        </div>
    <?php endif; ?>

    <div class="admin__page-actions">
        <a class="action-default" href="<?= $escaper->escapeUrl($block->getBackUrl()) ?>"><?= $escaper->escapeHtml(__('Back')) ?></a>
        <button type="submit" class="action-primary"><?= $escaper->escapeHtml(__('Save')) ?></button>
    </div>
</form>
