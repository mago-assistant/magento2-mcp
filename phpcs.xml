<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="PHP_CodeSniffer" xsi:noNamespaceSchemaLocation="phpcs.xsd">
    <description>Mago Assistant MCP addon configuration for CodeSniffer, mirroring MagoAssistant_Mago.</description>

    <rule ref="Magento2">
        <exclude name="Magento2.Annotation.MethodAnnotationStructure.NoCommentBlock"/>
        <exclude name="Magento2.PHP.FinalImplementation.FoundFinal"/>
    </rule>

    <exclude-pattern>registration.php</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/.phpunit.cache/*</exclude-pattern>
    <exclude-pattern>Test/Unit/Fakes/fake-mcp-server.php</exclude-pattern>

    <rule ref="Generic.PHP.RequireStrictTypes">
        <severity>9</severity>
        <exclude-pattern>*.phtml</exclude-pattern>
    </rule>

    <!-- The stdio client tests probe real processes; production code stays fully covered. -->
    <rule ref="Magento2.Functions.DiscouragedFunction">
        <exclude-pattern>*/Test/*</exclude-pattern>
    </rule>

    <!-- exec() is how the same stdio client tests read pgrep output to assert no orphaned process
         remains after a timeout or a handshake failure; production code never calls it. -->
    <rule ref="Magento2.Security.InsecureFunction">
        <exclude-pattern>*/Test/*</exclude-pattern>
    </rule>
</ruleset>
